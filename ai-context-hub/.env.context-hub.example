# Put these in the same .env file used by your Open WebUI compose project.
# Generate the two random secrets with: openssl rand -hex 32

OPENWEBUI_API_KEY=REPLACE_WITH_OPEN_WEBUI_API_KEY
CONTEXT_HUB_TOKEN=REPLACE_WITH_RANDOM_64_HEX_TOKEN
OPENCODE_PASSWORD=REPLACE_WITH_RANDOM_64_HEX_PASSWORD
OPENCODE_USERNAME=opencode
OWUI_SYNC_INTERVAL=60

# Optional: comma-separated Open WebUI Knowledge Base IDs that the shared bridge may query.
# Leave empty to rely on Open WebUI's own API access checks.
OPENWEBUI_KNOWLEDGE_IDS=
